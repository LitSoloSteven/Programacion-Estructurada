using System;
using System.Collections.Generic;

public class Program
{
    public const int LimiteArbol = 15;

    public static void Main(string[] args)
    {
        ArbolNumeros arbol = new ArbolNumeros(LimiteArbol);
        int opcion = 0;

        Console.WriteLine("--- Programa de Árbol de Números Binario de Búsqueda ---");
        Console.WriteLine($"Nota: Límite máximo de elementos es {LimiteArbol}.");
        Console.WriteLine();

        while (opcion != 6)
        {
            MostrarMenu();
            if (int.TryParse(Console.ReadLine(), out opcion))
            {
                switch (opcion)
                {
                    case 1:
                        InsertarVariosNumeros(arbol);
                        break;
                    case 2:
                        BuscarNumero(arbol);
                        break;
                    case 3:
                        arbol.RecorridoInorden();
                        break;
                    case 4:
                        ValidarVacio(arbol);
                        break;
                    case 5:
                        arbol.MostrarEstructuraPiramidal();
                        break;
                    case 6:
                        Console.WriteLine("Saliendo del programa. ¡Hasta luego!");
                        break;
                    default:
                        Console.WriteLine("Opción no válida. Elige del 1 al 6.");
                        break;
                }
            }
            else
            {
                Console.WriteLine("Entrada no válida. Ingresa un número.");
            }
            Console.WriteLine();
        }
    }

    private static void MostrarMenu()
    {
        Console.WriteLine("Selecciona una opción:");
        Console.WriteLine("1. Insertar varios números");
        Console.WriteLine("2. Buscar uno específico");
        Console.WriteLine("3. Mostrar recorrido Inorden");
        Console.WriteLine("4. Validar si el árbol está vacío");
        Console.WriteLine("5. Mostrar estructura piramidal (real)");
        Console.WriteLine("6. Salir");
        Console.Write("Tu opción: ");
    }

    private static void InsertarVariosNumeros(ArbolNumeros arbol)
    {
        Console.Write("Ingresa números separados por espacios: ");
        string entrada = Console.ReadLine();
        string[] numerosTexto = entrada.Split(new char[] { ' ' }, StringSplitOptions.RemoveEmptyEntries);

        foreach (string numTexto in numerosTexto)
        {
            if (arbol.ContarNodos() >= LimiteArbol)
            {
                Console.WriteLine($"Límite de {LimiteArbol} alcanzado. No se insertarán más elementos.");
                break;
            }

            if (int.TryParse(numTexto, out int numero))
            {
                arbol.Insertar(numero);
                Console.WriteLine($"Número {numero} insertado.");
            }
            else
            {
                Console.WriteLine($"'{numTexto}' no es un número válido y fue omitido.");
            }
        }
    }

    private static void BuscarNumero(ArbolNumeros arbol)
    {
        if (arbol.EstaVacio())
        {
            Console.WriteLine("El árbol está vacío.");
            return;
        }

        Console.Write("Ingresa el número a buscar: ");
        if (int.TryParse(Console.ReadLine(), out int numeroBuscado))
        {
            Console.WriteLine(arbol.Buscar(numeroBuscado)
                ? $"VALIDACIÓN: El número {numeroBuscado} SÍ está en el árbol."
                : $"VALIDACIÓN: El número {numeroBuscado} NO está en el árbol.");
        }
        else
        {
            Console.WriteLine("Entrada no válida. Ingresa un número entero.");
        }
    }

    private static void ValidarVacio(ArbolNumeros arbol)
    {
        Console.WriteLine(arbol.EstaVacio()
            ? "VALIDACIÓN: El árbol está vacío."
            : "VALIDACIÓN: El árbol NO está vacío.");
    }
}

// ===============================================================
// CLASE ÁRBOL BINARIO DE BÚSQUEDA
// ===============================================================
public class ArbolNumeros
{
    public Nodo Raiz;
    private int limite;
    private int contadorNodos;

    public ArbolNumeros(int limiteElementos)
    {
        Raiz = null;
        limite = limiteElementos;
        contadorNodos = 0;
    }

    public void Insertar(int valor)
    {
        if (contadorNodos < limite && !Buscar(valor))
        {
            Raiz = InsertarRecursivo(Raiz, valor);
            contadorNodos++;
        }
    }

    public bool Buscar(int valor) => BuscarRecursivo(Raiz, valor);

    public void RecorridoInorden()
    {
        if (EstaVacio())
        {
            Console.WriteLine("El árbol está vacío.");
            return;
        }

        Console.Write("Recorrido Inorden: ");
        RecorridoInordenRecursivo(Raiz);
        Console.WriteLine();
    }

    public bool EstaVacio() => Raiz == null;
    public int ContarNodos() => contadorNodos;

    // ============================================================
    // Mostrar árbol en forma PIRAMIDAL (centrado)
    // ============================================================
    public void MostrarEstructuraPiramidal()
    {
        if (Raiz == null)
        {
            Console.WriteLine("El árbol está vacío. No hay estructura para mostrar.");
            return;
        }

        Console.WriteLine("\n--- Estructura Piramidal del Árbol ---");

        int altura = ObtenerAltura(Raiz);
        Queue<Nodo> cola = new Queue<Nodo>();
        cola.Enqueue(Raiz);

        int nivel = 1;
        while (nivel <= altura)
        {
            int cantidadNodos = cola.Count;
            int espaciosEntre = (int)Math.Pow(2, altura - nivel + 1) - 1;
            int espaciosInicio = (int)Math.Pow(2, altura - nivel) - 1;

            // Espacios iniciales
            Console.Write(new string(' ', espaciosInicio));

            for (int i = 0; i < cantidadNodos; i++)
            {
                Nodo actual = cola.Dequeue();
                if (actual != null)
                {
                    Console.Write($"{actual.Valor}");
                    cola.Enqueue(actual.Izquierdo);
                    cola.Enqueue(actual.Derecho);
                }
                else
                {
                    Console.Write(" ");
                    cola.Enqueue(null);
                    cola.Enqueue(null);
                }

                if (i < cantidadNodos - 1)
                    Console.Write(new string(' ', espaciosEntre));
            }

            Console.WriteLine();
            nivel++;
        }
    }

    private int ObtenerAltura(Nodo nodo)
    {
        if (nodo == null) return 0;
        return 1 + Math.Max(ObtenerAltura(nodo.Izquierdo), ObtenerAltura(nodo.Derecho));
    }

    // ------------------------------------------------------------
    // Implementaciones internas
    // ------------------------------------------------------------
    private Nodo InsertarRecursivo(Nodo actual, int valor)
    {
        if (actual == null)
            return new Nodo(valor);

        if (valor < actual.Valor)
            actual.Izquierdo = InsertarRecursivo(actual.Izquierdo, valor);
        else if (valor > actual.Valor)
            actual.Derecho = InsertarRecursivo(actual.Derecho, valor);

        return actual;
    }

    private bool BuscarRecursivo(Nodo actual, int valor)
    {
        if (actual == null)
            return false;

        if (valor == actual.Valor)
            return true;
        else if (valor < actual.Valor)
            return BuscarRecursivo(actual.Izquierdo, valor);
        else
            return BuscarRecursivo(actual.Derecho, valor);
    }

    private void RecorridoInordenRecursivo(Nodo actual)
    {
        if (actual == null) return;
        RecorridoInordenRecursivo(actual.Izquierdo);
        Console.Write(actual.Valor + " ");
        RecorridoInordenRecursivo(actual.Derecho);
    }
}

// ===============================================================
// NODO DEL ÁRBOL
// ===============================================================
public class Nodo
{
    public int Valor;
    public Nodo Izquierdo;
    public Nodo Derecho;

    public Nodo(int valor)
    {
        Valor = valor;
        Izquierdo = Derecho = null;
    }
}
