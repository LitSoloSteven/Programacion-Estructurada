using System;
using System.Collections.Generic; // para usar Stack

namespace SimulacionUndo
{
    class Program
    {
        static void Main(string[] args)
        {
            // Pila para guardar las acciones realizadas
            Stack<string> acciones = new Stack<string>();
            bool continuar = true;
            int opcion = 0;

            while (continuar)
            {
                Console.WriteLine("Simulador de deshacer");
                Console.WriteLine("1. Ingresar acciones ");
                Console.WriteLine("2. Mostrar acciones");
                Console.WriteLine("3. Deshacer última acción");
                Console.WriteLine("4. Salir");
                Console.Write("Elige una opción: ");

                // Validar que el usuario escriba un número
                if (!int.TryParse(Console.ReadLine(), out opcion))
                {
                    Console.WriteLine("Por favor, ingresa un número válido.\n");
                    continue;
                }

                switch (opcion)
                {
                    case 1:
                        // Ingresar hasta 5 acciones
                        Console.WriteLine("\nIngresa hasta 5 acciones");
                        Console.WriteLine("Escribe 'x' si quieres dejar de ingresar antes de llegar a 5.\n");

                        for (int i = 0; i < 5; i++)
                        {
                            Console.Write($"Acción #{i + 1}: ");
                            string accion = Console.ReadLine();

                            if (accion.ToLower() == "x")
                            {
                                Console.WriteLine("Dejando de ingresar acciones...\n");
                                break;
                            }

                            if (!string.IsNullOrWhiteSpace(accion))
                            {
                                acciones.Push(accion);
                                Console.WriteLine("Acción guardada correctamente.");
                            }
                            else
                            {
                                Console.WriteLine("La acción no puede estar vacía.");
                                i--; // repetir el mismo intento
                            }
                        }
                        Console.WriteLine();
                        break;

                    case 2:
                        // Mostrar todas las acciones almacenadas
                        if (acciones.Count > 0)
                        {
                            Console.WriteLine("\nAcciones actuales en la pila:");
                            foreach (string a in acciones)
                            {
                                Console.WriteLine(a);
                            }
                            Console.WriteLine();
                        }
                        else
                        {
                            Console.WriteLine("\nNo hay acciones registradas.\n");
                        }
                        break;

                    case 3:
                        // Simular "Deshacer" eliminando la última acción
                        if (acciones.Count > 0)
                        {
                            string deshecha = acciones.Pop();
                            Console.WriteLine($"\nSe deshizo la última acción: '{deshecha}'");
                            Console.WriteLine("Estado actual de la pila:");

                            if (acciones.Count > 0)
                            {
                                foreach (string a in acciones)
                                {
                                    Console.WriteLine(a);
                                }
                            }
                            else
                            {
                                Console.WriteLine("Ya no quedan acciones por deshacer.");
                            }
                            Console.WriteLine();
                        }
                        else
                        {
                            Console.WriteLine("\nNo hay acciones para deshacer (la pila está vacía).\n");
                        }
                        break;

                    case 4:
                        // Salir del programa
                        continuar = false;
                        Console.WriteLine("\nPrograma finalizado. ¡Hasta luego!");
                        break;

                    default:
                        Console.WriteLine("\nOpción no válida. Intenta otra vez.\n");
                        break;
                }
            }

            Console.WriteLine("\nPresiona cualquier tecla para salir...");
            Console.ReadKey();
        }
    }
}
