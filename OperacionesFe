using System;
using System.Drawing;
using System.Windows.Forms;

static class Program
{
    // =================================================================
    // DECLARACIÓN GLOBAL DE CONTROLES
    // La matriz (DataGridView) y sus componentes de entrada/salida.
    // =================================================================
    private static DataGridView dgvMatriz;           
    private static TextBox txtFila, txtColumna, txtValor; 
    private static ListBox lbRecorrido;               
    private static Button btnInicializar, btnAsignar, btnBorrar, btnBuscar, btnRecorrer; 

    // =================================================================
    // FUNCIÓN PRINCIPAL: Main() (Constructor del Formulario)
    // =================================================================
    [STAThread]
    static void Main()
    {
        Application.EnableVisualStyles();
        Application.SetCompatibleTextRenderingDefault(false);

        Form form = new Form();
        form.Text = "Operaciones con Matrices (Tamaño Dinámico)";
        form.StartPosition = FormStartPosition.CenterScreen;
        form.ClientSize = new Size(650, 500); 

        // ----------------- Controles de Datos y Matriz -----------------
        dgvMatriz = new DataGridView() {
            Location = new Point(20, 20),
            Size = new Size(350, 150),
            AllowUserToAddRows = false,
            AutoSizeColumnsMode = DataGridViewAutoSizeColumnsMode.Fill
        };
        form.Controls.Add(dgvMatriz);

        // TextBoxes y Etiquetas (Usados para Inicializar y Operaciones)
        txtFila = new TextBox() { Location = new Point(480, 20), Size = new Size(50, 20) };
        txtColumna = new TextBox() { Location = new Point(540, 20), Size = new Size(50, 20) };
        txtValor = new TextBox() { Location = new Point(480, 60), Size = new Size(110, 20) };
        
        form.Controls.Add(new Label() { Text = "Fila", Location = new Point(480, 5), AutoSize = true });
        form.Controls.Add(new Label() { Text = "Col", Location = new Point(540, 5), AutoSize = true });
        form.Controls.Add(new Label() { Text = "Valor", Location = new Point(430, 63), AutoSize = true });
        form.Controls.Add(txtFila);
        form.Controls.Add(txtColumna);
        form.Controls.Add(txtValor);

        // ListBox para Recorrido y Resultados
        lbRecorrido = new ListBox() { Location = new Point(20, 280), Size = new Size(610, 200) };
        form.Controls.Add(lbRecorrido);

        // **BOTÓN DE INICIALIZACIÓN DINÁMICA**
        btnInicializar = new Button() { Text = "1. Inicializar Matriz (Leer Fila/Col)", Location = new Point(400, 100), Size = new Size(190, 30) };
        form.Controls.Add(btnInicializar);
        
        // ----------------- Creación y Posicionamiento de Botones (Operaciones) -----------------
        int y_pos_fila = 180; 

        // FILA ÚNICA: Operaciones 2 a 6
        btnAsignar = new Button() { Text = "2/4. Asignar/Actualizar", Location = new Point(20, y_pos_fila), Size = new Size(150, 30) };
        btnBorrar = new Button() { Text = "3. Borrar (Vacío)", Location = new Point(175, y_pos_fila), Size = new Size(100, 30) };
        btnBuscar = new Button() { Text = "5. Buscar", Location = new Point(280, y_pos_fila), Size = new Size(100, 30) };
        btnRecorrer = new Button() { Text = "6. Recorrer y Mostrar", Location = new Point(385, y_pos_fila), Size = new Size(225, 30) };
        
        form.Controls.Add(btnAsignar);
        form.Controls.Add(btnBorrar);
        form.Controls.Add(btnBuscar);
        form.Controls.Add(btnRecorrer);

        // ----------------- Vinculación de Eventos -----------------
        InicializarMatriz(3, 4); // Inicializa matriz 3x4 por defecto al iniciar

        // VINCULACIÓN DINÁMICA
        btnInicializar.Click += btnInicializar_Click; 
        
        // VINCULACIÓN DE OPERACIONES BÁSICAS
        btnAsignar.Click += btnAsignar_Click;
        btnBorrar.Click += btnBorrar_Click;
        btnBuscar.Click += btnBuscar_Click;
        btnRecorrer.Click += btnRecorrer_Click;
        
        Application.Run(form);
    }

    // =================================================================
    // FUNCIÓN 1: Inicializar Matriz (DINÁMICA - Lógica del botón)
    // =================================================================
    private static void btnInicializar_Click(object sender, EventArgs e)
    {
        // 1. Lectura y validación de entrada
        if (!int.TryParse(txtFila.Text, out int filas) || !int.TryParse(txtColumna.Text, out int columnas))
        {
            MessageBox.Show("¡ERROR! Ingrese números enteros válidos en Fila y Columna para inicializar la matriz.");
            return;
        }

        // 2. Validación de dimensiones positivas
        if (filas <= 0 || columnas <= 0)
        {
            MessageBox.Show("¡ERROR! Las dimensiones de la matriz deben ser mayores a cero.");
            return;
        }

        // 3. Llama a la función que realiza el redimensionamiento
        InicializarMatriz(filas, columnas); 

        MessageBox.Show($"Matriz inicializada correctamente con {filas} filas y {columnas} columnas.");
    }
    
    // -----------------------------------------------------------------
    // FUNCIÓN AUXILIAR: InicializarMatriz (Lógica de Redimensionamiento)
    // -----------------------------------------------------------------
    private static void InicializarMatriz(int filas, int columnas)
    {
        dgvMatriz.Rows.Clear();    
        dgvMatriz.Columns.Clear(); 
        
        // Agrega las columnas
        for (int j = 0; j < columnas; j++)
        {
            dgvMatriz.Columns.Add("Col" + j, j.ToString()); 
        }

        // Agrega las filas
        dgvMatriz.Rows.Add(filas);
        
        // Establece los encabezados de fila
        for (int i = 0; i < filas; i++)
        {
            dgvMatriz.Rows[i].HeaderCell.Value = i.ToString();
        }
    }

    // =================================================================
    // OPERACIÓN 2 y 4: Asignar/Actualizar
    // =================================================================
    private static void btnAsignar_Click(object sender, EventArgs e)
    {
        if (!int.TryParse(txtFila.Text, out int fila) || !int.TryParse(txtColumna.Text, out int col))
        {
            MessageBox.Show("Ingrese números enteros válidos para Fila y Columna.");
            return;
        }

        string valor = txtValor.Text;
        
        if (string.IsNullOrEmpty(valor))
        {
            MessageBox.Show("El campo 'Valor' no puede estar vacío para Asignar/Actualizar.");
            return;
        }

        if (fila >= 0 && fila < dgvMatriz.RowCount && col >= 0 && col < dgvMatriz.ColumnCount)
        {
            // Asigna el valor en la posición [fila, col]
            dgvMatriz.Rows[fila].Cells[col].Value = valor; 
            MessageBox.Show($"Valor '{valor}' asignado/actualizado en la posición [{fila},{col}].");
        }
        else
        {
            MessageBox.Show("Índices de fila o columna fuera de rango.");
        }
    }

    // =================================================================
    // OPERACIÓN 3: Borrar (elemento)
    // =================================================================
    private static void btnBorrar_Click(object sender, EventArgs e)
    {
        if (!int.TryParse(txtFila.Text, out int fila) || !int.TryParse(txtColumna.Text, out int col))
        {
            MessageBox.Show("Ingrese números enteros válidos para Fila y Columna.");
            return;
        }

        if (fila >= 0 && fila < dgvMatriz.RowCount && col >= 0 && col < dgvMatriz.ColumnCount)
        {
            // Borra al asignar 'null'
            dgvMatriz.Rows[fila].Cells[col].Value = null; 
            MessageBox.Show($"Elemento borrado (celda vacía) en [{fila},{col}].");
        }
        else
        {
            MessageBox.Show("Índices de fila o columna fuera de rango.");
        }
    }

    // =================================================================
    // OPERACIÓN 5: Buscar (elemento)
    // =================================================================
    private static void btnBuscar_Click(object sender, EventArgs e)
    {
        string valorBuscado = txtValor.Text.Trim();
        if (string.IsNullOrEmpty(valorBuscado))
        {
            MessageBox.Show("Ingrese un valor a buscar en el campo 'Valor'.");
            return;
        }

        int count = 0;
        // Reinicia colores y busca el elemento
        foreach (DataGridViewRow row in dgvMatriz.Rows)
        {
            foreach (DataGridViewCell cell in row.Cells)
            {
                cell.Style.BackColor = dgvMatriz.DefaultCellStyle.BackColor; // Limpia resaltado

                if (cell.Value != null && cell.Value.ToString() == valorBuscado)
                {
                    cell.Style.BackColor = Color.Yellow; // Resalta
                    count++;
                }
            }
        }

        if (count > 0)
        {
            MessageBox.Show($"Se encontraron {count} ocurrencia(s) del valor '{valorBuscado}'. Las celdas se han resaltado.");
        }
        else
        {
            MessageBox.Show($"El valor '{valorBuscado}' no se encontró en la matriz.");
        }
    }

    // =================================================================
    // OPERACIÓN 6: Recorrer (elementos)
    // =================================================================
    private static void btnRecorrer_Click(object sender, EventArgs e)
    {
        lbRecorrido.Items.Clear();
        lbRecorrido.Items.Add("Recorrido de la Matriz (Fila por Fila):");
        
        int filas = dgvMatriz.RowCount;
        int columnas = dgvMatriz.ColumnCount;

        for (int i = 0; i < filas; i++) // Bucle exterior (Filas)
        {
            string filaString = $"Fila {i}: [ ";
            for (int j = 0; j < columnas; j++) // Bucle interior (Columnas)
            {
                object cellValue = dgvMatriz.Rows[i].Cells[j].Value;
                
                // Concatena el valor, o "vacio" si la celda no tiene contenido.
                string valor = (cellValue != null && !string.IsNullOrEmpty(cellValue.ToString())) ? cellValue.ToString() : "vacio";
                
                filaString += valor;
                if (j < columnas - 1)
                {
                    filaString += ", "; 
                }
            }
            filaString += " ]";
            lbRecorrido.Items.Add(filaString);
        }
    }
}
