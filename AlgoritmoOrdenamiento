using System;
using System.Diagnostics; // stopwatch

// --- 1. CONFIGURACION ---

int N = 20000; 
int[] arrayOriginal = GenerarArrayAleatorio(N);

Console.WriteLine($"Comparacion de Algoritmos con N = {N} elementos.");
Console.WriteLine("==================================================");

// --- 2. PRUEBAS DE ORDENAMIENTO ---
Console.WriteLine("\n### 1. Pruebas de Ordenamiento ###");

// Clonamos el array para que cada algoritmo ordene los mismos datos
int[] arrayParaBurbuja = (int[])arrayOriginal.Clone();
int[] arrayParaInsercion = (int[])arrayOriginal.Clone();
int[] arrayParaSeleccion = (int[])arrayOriginal.Clone();


// Algoritmo 1: Bubble Sort (Burbuja)
Stopwatch swBurbuja = Stopwatch.StartNew();
OrdenamientoBurbuja(arrayParaBurbuja);
swBurbuja.Stop();
Console.WriteLine($"Bubble Sort (Burbuja):   {swBurbuja.Elapsed.TotalMilliseconds:F4} ms");

// Algoritmo 2: Insertion Sort (Insercion)
Stopwatch swInsercion = Stopwatch.StartNew();
OrdenamientoInsercion(arrayParaInsercion);
swInsercion.Stop();
Console.WriteLine($"Insertion Sort (Insercion): {swInsercion.Elapsed.TotalMilliseconds:F4} ms");

// Algoritmo 3: Selection Sort (Seleccion)
Stopwatch swSeleccion = Stopwatch.StartNew();
OrdenamientoSeleccion(arrayParaSeleccion); // Usaremos este array ordenado para buscar
swSeleccion.Stop();
Console.WriteLine($"Selection Sort (Seleccion): {swSeleccion.Elapsed.TotalMilliseconds:F4} ms");


// --- 3. PRUEBAS DE BUSQUEDA (NUEVO) ---
Console.WriteLine("\n### 2. Pruebas de Busqueda ###");

// Usaremos el array que ya ordeno Selection Sort
// Para probar el "peor caso" de la Lineal, buscamos el ultimo elemento.
int target = arrayParaSeleccion[N - 1]; 

// Algoritmo 4: Busqueda Lineal
Stopwatch swLineal = Stopwatch.StartNew();
int idxLineal = BusquedaLineal(arrayParaSeleccion, target);
swLineal.Stop();
Console.WriteLine($"Busqueda Lineal:   {swLineal.Elapsed.TotalMilliseconds:F4} ms (Indice: {idxLineal})");

// Algoritmo 5: Busqueda Binaria
Stopwatch swBinaria = Stopwatch.StartNew();
int idxBinaria = BusquedaBinaria(arrayParaSeleccion, target);
swBinaria.Stop();
Console.WriteLine($"Busqueda Binaria:  {swBinaria.Elapsed.TotalMilliseconds:F4} ms (Indice: {idxBinaria})");


Console.WriteLine("\n==================================================");
Console.WriteLine("Pruebas finalizadas.");


// --- DEFINICION DE METODOS ---

int[] GenerarArrayAleatorio(int tamano)
{
    Random rand = new Random();
    int[] arr = new int[tamano];
    for (int i = 0; i < tamano; i++)
    {
        arr[i] = rand.Next(0, tamano * 10);
    }
    return arr;
}

/// Algoritmo 1: Ordenamiento Burbuja
void OrdenamientoBurbuja(int[] arr)
{
    int n = arr.Length;
    for (int i = 0; i < n - 1; i++)
    {
        for (int j = 0; j < n - i - 1; j++)
        {
            if (arr[j] > arr[j + 1])
            {
                // Intercambio
                int temp = arr[j];
                arr[j] = arr[j + 1];
                arr[j + 1] = temp;
            }
        }
    }
}

/// Algoritmo 2: Ordenamiento por Insercion
void OrdenamientoInsercion(int[] arr)
{
    int n = arr.Length;
    for (int i = 1; i < n; ++i)
    {
        int key = arr[i];
        int j = i - 1;

        // Mueve los elementos ...
        while (j >= 0 && arr[j] > key)
        {
            arr[j + 1] = arr[j];
            j = j - 1;
        }
        arr[j + 1] = key;
    }
}

/// Algoritmo 3: Ordenamiento por Seleccion
void OrdenamientoSeleccion(int[] arr)
{
    int n = arr.Length;
    
    for (int i = 0; i < n - 1; i++)
    {
        // Encontrar el elemento minimo...
        int min_idx = i;
        for (int j = i + 1; j < n; j++)
        {
            if (arr[j] < arr[min_idx])
            {
                min_idx = j; 
            }
        }

        // Intercambiar el elemento minimo...
        int temp = arr[min_idx];
        arr[min_idx] = arr[i];
        arr[i] = temp;
    }
}

/// --- NUEVOS METODOS AÑADIDOS ---

/// Algoritmo 4: Busqueda Lineal
/// Revisa cada elemento uno por uno.
int BusquedaLineal(int[] arr, int target)
{
    int n = arr.Length;
    for (int i = 0; i < n; i++)
    {
        if (arr[i] == target)
        {
            return i; // Encontrado
        }
    }
    return -1; // No encontrado
}

/// Algoritmo 5: Busqueda Binaria
/// Requiere que el array este ORDENADO.
/// Corta el array por la mitad en cada paso.
int BusquedaBinaria(int[] arr, int target)
{
    int left = 0;
    int right = arr.Length - 1;

    while (left <= right)
    {
        // Calcula el indice del medio
        int mid = left + (right - left) / 2;

        // Si encontramos el objetivo
        if (arr[mid] == target)
        {
            return mid; // Encontrado
        }

        // Si el objetivo es mas grande, ignoramos la mitad izquierda
        if (arr[mid] < target)
        {
            left = mid + 1;
        }
        // Si el objetivo es mas pequeno, ignoramos la mitad derecha
        else
        {
            right = mid - 1;
        }
    }
    
    return -1; // No encontrado
}
